# ---- Arc network (verify against https://docs.arc.io/arc/references/connect-to-arc.md) ----
ARC_NETWORK=testnet                       # testnet | mainnet
ARC_RPC_URL=https://rpc.testnet.arc.io
ARC_CHAIN_ID=5042002
# ERC-20 interface of native USDC (6 decimals) — https://docs.arc.io/arc/references/contract-addresses.md
ARC_USDC_ADDRESS=0x3600000000000000000000000000000000000000

# ---- Deployer (contracts). Funded with testnet USDC from https://faucet.circle.com ----
DEPLOYER_PRIVATE_KEY=

# ---- Agent wallet: a DEDICATED key, never the treasury owner. Server-side only. ----
AGENT_PRIVATE_KEY=
ANTHROPIC_API_KEY=                        # optional: enables LLM-written reasoning; policy checks stay deterministic

# ---- API ----
DATABASE_URL=postgresql://localhost:5432/vaultos
API_PORT=4000
SESSION_SECRET=change-me
TREASURY_FACTORY_ADDRESS=

# ---- Web (public values only — NEVER put keys here) ----
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_ARC_RPC_URL=https://rpc.testnet.arc.io
NEXT_PUBLIC_ARC_CHAIN_ID=5042002
NEXT_PUBLIC_USDC_ADDRESS=0x3600000000000000000000000000000000000000
NEXT_PUBLIC_EXPLORER_URL=https://explorer.testnet.arc.io
NEXT_PUBLIC_FACTORY_ADDRESS=
